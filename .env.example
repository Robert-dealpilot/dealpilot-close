# Copy to .env and fill in. Never commit .env.

# PayPal REST app (Sandbox) — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox API base (do not change for the demo)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook id from the app's Webhooks page (for signature verification of INVOICING.INVOICE.PAID etc.)
PAYPAL_WEBHOOK_ID=
# Optional: email of a sandbox *personal* (buyer) account; invoices are addressed here so you can pay them in the sandbox.
PAYPAL_SANDBOX_BUYER_EMAIL=

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Server
PORT=3000
# Name shown as the seller on invoices (fictional sample company)
SELLER_NAME=Formosa Precision Tools Co. (sample)
